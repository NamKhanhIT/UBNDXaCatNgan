# ==========================================
# Comprehensive .gitignore for UBNDXaCN
# Includes .NET 8, Next.js, VS, Secrets, OS & AI/ML
# ==========================================

# ------------------------------------------
# 1. Environment & Secrets (Bảo mật 100%)
# ------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
appsettings.Development.json
appsettings.Development.*.json
appsettings.Secrets.json
appsettings.*.user.json
appsettings.Production.json
launchSettings.json
*.pem
*.pfx
*.key
*.crt
*.secret
*.token
secrets/
private/

# ------------------------------------------
# 2. AI / ML / Model Weights & Training Data Security
# ------------------------------------------
# Model weights & Checkpoints (Bảo vệ tài sản trí tuệ & chống rò rỉ dung lượng lớn)
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.gguf
*.ckpt
*.h5
*.joblib
*.pkl

# Training outputs, checkpoints & LoRA adapters
outputs_*/
models_export/
checkpoint-*/
checkpoints/
lora_model/
lora_adapter/
runs/
wandb/
tb_logs/
.cache/
hf_cache/

# Vector Databases & Embeddings Index
vector_db/
chroma_db/
faiss_index/
*.faiss
*.index
*.sqlite3

# Training Datasets & Binary Documents (Chặn tuyệt đối dữ liệu nghiệp vụ)
*.jsonl
!scripts/ai_pipeline/data/sample_template.jsonl
*.pdf
*.docx
*.doc
*.xlsx
*.xls
scripts/ai_pipeline/data/raw/
scripts/ai_pipeline/data/private/
scripts/ai_pipeline/huggingface_space/data/
scripts/ai_pipeline/data/*_raw.*
scripts/ai_pipeline/data/*_private.*

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ------------------------------------------
# 3. Backup Archives & Large Files
# ------------------------------------------
*.zip
*.7z
*.rar
*.tar.gz
UBNDXaCN.zip

# ------------------------------------------
# 4. .NET / C# Build Artifacts & IDE Files
# ------------------------------------------
bin/
obj/
[B|b]in/
[O|o]bj/
.vs/
*.user
*.userosscache
*.sln.docstates
*.suo
*.userprefs
TestResults/
[T|t]est[R|r]esults/
*.DotSettings.user
*.pidb
*.ide/

# ------------------------------------------
# 5. Frontend (Node.js / Next.js / React)
# ------------------------------------------
node_modules/
.next/
out/
dist/
.turbo/
tsconfig.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache

# ------------------------------------------
# 6. OS & Temporary Files
# ------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
*.log
*.tmp
tmp/
scratch/
uploads/
[U|u]ploads/
**/uploads/**

# ------------------------------------------
# 7. Python Artifacts & Caches
# ------------------------------------------
__pycache__/
**/__pycache__/**
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
